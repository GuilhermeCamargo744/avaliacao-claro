{
  "info": {
    "name": "Team Management API",
    "description": "Chamadas da API de gestão de times e tarefas. Suba a API com `npm run db:up` antes de rodar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "teamId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "taskTeamId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Times",
      "item": [
        {
          "name": "Criar time",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/teams",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams"
              ]
            },
            "description": "Guarda o id do time criado na variável {{teamId}}, usada pelas chamadas seguintes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Time Alpha\",\n  \"colorHex\": \"#2563EB\",\n  \"description\": \"Squad de produto\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "const team = pm.response.json();",
                  "pm.test('devolve o time criado', () => {",
                  "  pm.expect(team.id).to.be.a('string');",
                  "  pm.expect(team.name).to.eql('Time Alpha');",
                  "});",
                  "pm.collectionVariables.set('teamId', team.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar times",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/teams",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('devolve uma lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar time por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/teams/{{teamId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams",
                "{{teamId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('é o time criado', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('teamId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar time",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/teams/{{teamId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams",
                "{{teamId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Time Beta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('nome atualizado', () => pm.expect(pm.response.json().name).to.eql('Time Beta'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Remover time",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/teams/{{teamId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams",
                "{{teamId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tarefas",
      "item": [
        {
          "name": "Preparar: criar time",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/teams",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams"
              ]
            },
            "description": "O time existe só para vincular à tarefa; a última chamada da pasta o remove.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Time das tarefas\",\n  \"colorHex\": \"#16A34A\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('taskTeamId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar tarefa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ajustar layout da home\",\n  \"description\": \"chip de cor do time\",\n  \"status\": \"pending\",\n  \"teamIds\": [\n    \"{{taskTeamId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "const task = pm.response.json();",
                  "pm.test('nasce pendente e com o time vinculado', () => {",
                  "  pm.expect(task.status).to.eql('pending');",
                  "  pm.expect(task.teams[0].colorHex).to.eql('#16A34A');",
                  "});",
                  "pm.collectionVariables.set('taskId', task.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar tarefas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks?limit=20&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('envelope com data e meta', () => {",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.meta.total).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar por time",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks?teamId={{taskTeamId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "teamId",
                  "value": "{{taskTeamId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('só tarefas do time', () => {",
                  "  const teamId = pm.collectionVariables.get('taskTeamId');",
                  "  pm.response.json().data.forEach((t) => pm.expect(t.teams.map((x) => x.id)).to.include(teamId));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar por status, busca e ordenação",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks?status=pending&search=layout&sort=title&order=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                },
                {
                  "key": "search",
                  "value": "layout"
                },
                {
                  "key": "sort",
                  "value": "title"
                },
                {
                  "key": "order",
                  "value": "asc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('encontrou a tarefa', () => pm.expect(pm.response.json().meta.total).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar tarefa por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('é a tarefa criada', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('taskId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Alterar status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            },
            "description": "Ação rápida da tela de visualizar tarefa.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('status atualizado', () => pm.expect(pm.response.json().status).to.eql('done'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Remover tarefa",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Limpar: remover time",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/teams/{{taskTeamId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams",
                "{{taskTeamId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Erros",
      "item": [
        {
          "name": "Criar time inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/teams",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams"
              ]
            },
            "description": "name curto, colorHex ausente e campo desconhecido: as três queixas voltam em details.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ab\",\n  \"color\": \"azul\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('envelope de erro com detalhes', () => {",
                  "  pm.expect(body.error.code).to.eql('BAD_REQUEST');",
                  "  pm.expect(body.error.details).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar com id malformado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/teams/abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams",
                "abc"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('mensagem sobre o id', () => pm.expect(pm.response.json().error.message).to.include('UUID'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar time inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/teams/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams",
                "00000000-0000-0000-0000-000000000000"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 404', () => pm.response.to.have.status(404));",
                  "pm.test('envelope NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar tarefa com time inexistente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tarefa fantasma\",\n  \"teamIds\": [\n    \"22222222-2222-4222-8222-222222222222\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('diz qual time faltou', () => pm.expect(pm.response.json().error.message).to.include('Time não encontrado'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar tarefa com status inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tarefa inválida\",\n  \"status\": \"cancelada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('lista os status aceitos', () => pm.expect(pm.response.json().error.details[0]).to.include('pending'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar tarefa inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "00000000-0000-0000-0000-000000000000"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 404', () => pm.response.to.have.status(404));",
                  "pm.test('envelope NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
